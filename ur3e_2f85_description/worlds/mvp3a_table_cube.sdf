<?xml version="1.0" ?>

<sdf version="1.7">

  <world name="default">

    <!-- ============================== -->
    <!-- Physics                        -->
    <!-- ============================== -->

    <gravity>0 0 -9.81</gravity>

    <physics name="mvp3a_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>


    <!-- ============================== -->
    <!-- Light                          -->
    <!-- ============================== -->

    <light type="directional" name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ============================== -->
    <!-- Ground                         -->
    <!-- ============================== -->

    <model name="ground_plane">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>

        </collision>

        <visual name="ground_visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ============================== -->
    <!-- Table                          -->
    <!-- ============================== -->

    <model name="table">

      <static>true</static>

      <!--
        Table center:
          x = 0.45 m
          y = 0
          z = 0.0 m

        Thickness = 0.04 m

        Therefore table top:
          z = 0.02 m
      -->

      <pose>0.45 0 0.0 0 0 0</pose>

      <link name="table_top">

        <collision name="table_collision">

          <geometry>
            <box>
              <size>0.60 0.80 0.04</size>
            </box>
          </geometry>

        </collision>

        <visual name="table_visual">

          <geometry>
            <box>
              <size>0.60 0.80 0.04</size>
            </box>
          </geometry>

          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ============================== -->
    <!-- Green Block                    -->
    <!-- ============================== -->

    <model name="green_block">

      <static>false</static>

      <!--
        Block size = 40 mm

        Table top = 0.02 m
        Block half-height = 0.02 m

        Therefore block center:
        z = 0.04 m
      -->

      <pose>0.45 0 0.04 0 0 0</pose>

      <link name="block_link">


        <!-- 50 gram block -->

        <inertial>

          <mass>0.05</mass>

          <inertia>
            <ixx>0.00001333</ixx>
            <iyy>0.00001333</iyy>
            <izz>0.00001333</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>

        </inertial>


        <!-- Physical collision geometry -->

        <collision name="block_collision">

          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>

          <surface>

            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>

          </surface>

        </collision>


        <!-- Green appearance -->

        <visual name="block_visual">

          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>

          <material>

            <ambient>0.0 0.8 0.0 1</ambient>

            <diffuse>0.0 0.8 0.0 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>


      </link>

    </model>


  </world>

</sdf>
